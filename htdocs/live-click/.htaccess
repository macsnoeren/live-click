Options -Indexes
RewriteEngine On

# Redirect root to index.php
RewriteRule ^$ index.php [L]

# Block direct access to includes and data directories
RewriteRule ^(includes|data)/ - [F,L]

# Optionally block access to import.php from the web (remove this to allow browser import)
# RewriteRule ^import\.php$ - [F,L]
